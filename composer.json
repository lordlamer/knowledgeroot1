{
	"name": "lordlamer/knowledgeroot1",
	"description": "Knowledgeroot Knowledgebase",
	"keywords": ["knowledgeroot", "knowledgebase"],
	"homepage": "http://www.knowledgeroot.org",
	"type": "application",
	"license": "GPL-V2",
	"authors": [
		{
			"name": "Frank Habermann",
			"email": "lordlamer@lordlamer.de",
			"homepage": "http://www.lordlamer.de"
		}
	],

	"require": {
		"php": ">=8.2",
		"ext-pdo": "*",
		"slim/slim": "^4.15",
		"slim/psr7": "^1.8",
		"twig/twig": "^3.22",
		"symfony/mailer": "^7.2",
		"pimple/pimple": "^3.6",
		"doctrine/dbal": "^3.10",
		"php-di/php-di": "^7.1",
		"doctrine/migrations": "^3.9"
	},

	"autoload": {
		"psr-4": {
			"Knowledgeroot\\": "src/",
			"Knowledgeroot\\Migrations\\": "migrations/"
		}
	},

	"autoload-dev": {
		"psr-4": {
			"Knowledgeroot\\Tests\\": "tests/"
		}
	},

	"require-dev": {
		"phpunit/phpunit": "^13.2"
	},

	"scripts": {
		"test": "phpunit"
	}
}
