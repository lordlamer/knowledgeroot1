{% extends 'layout.html.twig' %}

{% block title %}{{ content.name }} - Knowledgeroot{% endblock %}

{% block breadcrumb %}
    {% include 'components/breadcrumb.html.twig' with {'category_path': category_path} %}
{% endblock %}

{% block content %}
    <article class="content-article">
        {# Content Header #}
        <header class="mb-4">
            <h1 class="display-4">{{ content.name }}</h1>

            {# Meta Information #}
            <div class="text-muted small mb-3">
                <i class="fas fa-user"></i>
                {% if author %}
                    <strong>{{ author.full_name }}</strong>
                {% else %}
                    Unknown Author
                {% endif %}
                •
                <i class="fas fa-calendar"></i>
                {{ content.created_at|date('Y-m-d H:i') }}
                {% if content.created_at != content.changed_at %}
                    •
                    <i class="fas fa-edit"></i>
                    Updated: {{ content.changed_at|date('Y-m-d H:i') }}
                {% endif %}
            </div>

            {# Description #}
            {% if content.description %}
                <p class="lead text-muted">{{ content.description }}</p>
            {% endif %}
        </header>

        {# Main Content #}
        <div class="content-body">
            {{ content.content|raw }}
        </div>

        {# Content Footer / Actions #}
        <footer class="mt-5 pt-3 border-top">
            <div class="btn-group" role="group">
                <a href="/content/{{ content.id }}/edit" class="btn btn-outline-primary">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="fas fa-print"></i> Print
                </button>
                <button type="button" class="btn btn-outline-info" onclick="navigator.clipboard.writeText(window.location.href)">
                    <i class="fas fa-share"></i> Share
                </button>
            </div>
        </footer>
    </article>

    {# Related Content Sidebar #}
    {% if related_content|length > 0 %}
        <aside class="mt-5">
            <h3>Related Content</h3>
            <div class="list-group">
                {% for related in related_content %}
                    <a href="/content/{{ related.id }}" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">{{ related.name }}</h5>
                            <small class="text-muted">
                                {{ related.changed_at|date('Y-m-d') }}
                            </small>
                        </div>
                        {% if related.description %}
                            <p class="mb-1 text-muted small">{{ related.description|slice(0, 150) }}...</p>
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </aside>
    {% endif %}
{% endblock %}

{% block javascripts %}
<script>
// Add syntax highlighting if needed
document.addEventListener('DOMContentLoaded', function() {
    // Apply syntax highlighting to code blocks
    document.querySelectorAll('pre code').forEach((block) => {
        // You can add highlight.js or similar here
    });
});
</script>
{% endblock %}
